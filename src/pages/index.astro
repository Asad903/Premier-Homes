---
import { SITE_NAME, SITE_URL, SITE_PHONE_HREF, SITE_EMAIL, SOCIAL } from "@/consts.ts";
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Icon from "@/components/media/Icon.astro";
import stars from "@/assets/icons/stars.svg";
import google from "@/assets/icons/google.svg";
import facebook from "@/assets/icons/facebook.svg";
import Faq from "@/components/section/Faq.astro";
import { reviews, reviewColumns } from "@/data/reviews.ts";
import HeroHome from "@/components/section/HeroHome.astro";
import TileBand from "@/components/content/TileBand.astro";
import ExploreVideo from "@/components/section/ExploreVideo.astro";
import ViewingTrip from "@/components/section/ViewingTrip.astro";
import BannerHome from "@/components/section/BannerHome.astro";
import FeaturesHome from "@/components/section/FeaturesHome.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import Slider from "@/components/interactive/Slider.astro";
import Tabs from "@/components/interactive/Tabs.astro";
import TabLink from "@/components/interactive/TabLink.astro";
import PropertyCard from "@/components/item/PropertyCard.astro";
import { getFeaturedProperties } from "@/utils/properties.ts";
import { getLatestPosts } from "@/utils/blog.ts";

// Featured properties and the latest posts come from Sanity on every request, so edits show without a rebuild.
export const prerender = false;

const [properties, latestPosts, blogPosts, guidePosts] = await Promise.all([
  getFeaturedProperties(6),
  getLatestPosts({ limit: 8 }),
  getLatestPosts({ category: "blog", limit: 8 }),
  getLatestPosts({ category: "guide", limit: 8 }),
]);
const blogTabs = [
  { label: "All", posts: latestPosts },
  { label: "Blogs", posts: blogPosts },
  { label: "Guides", posts: guidePosts },
].filter((tab) => tab.posts.length > 0);

const avatars = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/reviews/*",
  { eager: true },
);
const avatar = (file?: string) =>
  file ? avatars[`/src/assets/images/reviews/${file}`]?.default.src : undefined;
const sourceIcon = { google, facebook };

const schema = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: SITE_NAME,
  url: SITE_URL,
  logo: `${SITE_URL}/apple-touch-icon.png`,
  image: `${SITE_URL}/og-image.jpg`,
  telephone: SITE_PHONE_HREF.replace("tel:", ""),
  email: SITE_EMAIL,
  areaServed: ["Murcia", "Alicante"],
  sameAs: [SOCIAL.facebook, SOCIAL.tiktok],
};
---

<Layout
  theme="light"
  title="Property for Sale in Murcia & Alicante"
  description="Family-run estate agents in Murcia and Alicante. Find new build and resale homes with honest local advice, from first viewing to long after you get the keys."
  imageAlt="Solmar Homes: find the right home in Murcia and Alicante"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <!-- hero -->
  <HeroHome />
  <TileBand />
  <!-- featured properties -->
  {properties.length > 0 && (
    <Section paddingTop="small" paddingBottom="small">
      <div class="home-properties_head">
        <div class="home-properties_intro">
          <Eyebrow class="margin-bottom-4">Featured</Eyebrow>
          <Heading tag="h2" variant="h3" class="margin-top-0">Properties we love</Heading>
        </div>
        <Button element="link" emphasis="secondary" href="/listing">Show all properties</Button>
      </div>
      <Grid medium={2} large={3}>
        {properties.map((item) => <PropertyCard item={item} />)}
      </Grid>
    </Section>
  )}
  <!-- explore -->
  <Section paddingBottom="small">
    <ContentWrapper variant="auto-width" class="align-items-start">
      <Eyebrow>Explore Murcia &amp; Alicante</Eyebrow>
      <Heading slot="column2" tag="h2" variant="h3" maxWidth={34}>
        From quiet coastal mornings and lively town centres to golf resorts,
        beaches and year-round communities, Murcia and Alicante offer many
        different ways to live.
      </Heading>
    </ContentWrapper>
  </Section>
  <!-- explore video -->
  <ExploreVideo />
  <!-- viewing trip -->
  <ViewingTrip />
  <!-- banner -->
  <BannerHome />
  <!-- features -->
  <FeaturesHome />
  <TileBand />
  <!-- reviews -->
  <Section>
    <ContentWrapper centered={true}>
      <div class="reviews_rating">
        <div class="reviews_stars">
          <Icon src={stars} variant="full-width" />
        </div>
        <p class="text-style-h5">5.0</p>
        <p class="text-style-small">
          RECOMMENDATION ON{" "}
          <a href={SOCIAL.googleReviews} target="_blank" rel="noopener">GOOGLE</a>{" "}
          &amp;{" "}
          <a href={SOCIAL.facebookReviews} target="_blank" rel="noopener">FACEBOOK</a>
        </p>
      </div>
      <Heading tag="h2" variant="h2" maxWidth={22}>
        Relationships That Continue After Completion
      </Heading>
    </ContentWrapper>
    <Grid medium={2} large={3}>
      {reviewColumns.map((names, column) => (
        <div class:list={["reviews_col", column === 1 && "reverse"]}>
          <div class="reviews_track">
            {[0, 1].map((copy) => (
              <ul class="reviews_group" aria-hidden={copy === 1 ? "true" : undefined}>
                {names.map((name) => {
                  const review = reviews[name];
                  return (
                    <li class="reviews_card">
                      <p class="text-style-main reviews_text">{review.text}</p>
                      <div class="reviews_author">
                        <div class="reviews_person">
                          {avatar(review.avatar) && (
                            <img class="reviews_avatar" src={avatar(review.avatar)} alt="" width="44" height="44" loading="lazy" />
                          )}
                          <p class="text-style-main">{review.name}</p>
                        </div>
                        <Icon class="reviews_source" src={sourceIcon[review.source]} variant="small" />
                      </div>
                    </li>
                  );
                })}
              </ul>
            ))}
          </div>
        </div>
      ))}
    </Grid>
  </Section>
  <!-- blogs and guides -->
  {blogTabs.length > 0 && (
    <Section class="home-blog_wrap" containerClass="home-blog_contain" paddingTop="small" paddingBottom="small">
      <div class="home-blog_intro">
        <Eyebrow class="margin-bottom-4">Explore Murcia &amp; Alicante</Eyebrow>
        <Heading tag="h2" variant="h3" class="margin-top-0 margin-bottom-4">Blogs &amp; Guides</Heading>
        <p class="home-blog_text text-style-small">
          Discover all the latest updates, insights and valuable resources right here. This hub provides blog, detailed guides to keep you up to date.
        </p>
      </div>
      <Tabs class="home-blog_tabs">
        <Fragment slot="links">
          {blogTabs.map((tab) => <TabLink>{tab.label}</TabLink>)}
        </Fragment>
        {blogTabs.map((tab) => (
          <div class="home-blog_panel">
          <Slider label={`${tab.label} articles`} variant="contained" xsmall={1.2} small={1.6} medium={2.2} large={3.2}>
            {tab.posts.map((post) => (
              <a class="home-blog_card" href={`/blog/${post.slug}`}>
                <div class="home-blog_img_wrap">
                  {post.imageUrl && <Img class="home-blog_img" src={`${post.imageUrl}?auto=format`} width={900} height={1000} alt={post.imageAlt} />}
                </div>
                <p class="home-blog_tag text-style-main">{post.category?.title}</p>
                <h3 class="home-blog_title text-style-h6">{post.title}</h3>
              </a>
            ))}
          </Slider>
          </div>
        ))}
      </Tabs>
    </Section>
  )}
  <!-- faq -->
  <Faq />
</Layout>

<style is:global>
  @layer components {
    .home-properties_head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      width: 100%;
    }

    /* Heading on the left, category pills on the right, slider underneath. The tabs wrapper
       steps aside (display: contents) so its bar and panels can sit in this grid. */
    .container.home-blog_contain {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "intro" "bar" "panels";
      align-items: end;
      gap: var(--space-4) var(--space-6);
      @media (width >= 48rem) {
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas: "intro bar" "panels panels";
        gap: var(--space-7) var(--space-6);
      }
    }

    .home-blog_panel {
      min-width: 0;
    }

    .home-blog_intro {
      grid-area: intro;
    }

    .home-blog_text {
      max-width: 22rem;
      color: var(--dark-700);
    }

    .home-blog_tabs {
      display: contents;
    }

    .home-blog_wrap .tabs_bar {
      grid-area: bar;
    }

    .home-blog_wrap .tabs_panels {
      grid-area: panels;
    }

    .home-blog_wrap .tabs_links {
      gap: 0.75rem;
    }

    .home-blog_wrap .tabs_link {
      flex: none;
      min-width: 0;
      padding: 0.625rem 1.25rem;
      border: var(--border-width) solid var(--light-300);
      border-radius: var(--radius-small);
      color: var(--dark-700);
      &.is-active {
        border-color: var(--brand-500);
        color: var(--brand-500);
      }
    }

    .home-blog_wrap .slider_markers {
      display: none;
    }

    .home-blog_wrap .slider_controls {
      justify-content: flex-end;
    }

    .home-blog_card {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    /* The first card is shown tall; the others grow on hover, as on the live site. */
    .home-blog_img_wrap {
      overflow: clip;
      height: 32rem;
      max-height: 24rem;
      background-color: var(--background-2);
      transition: max-height 0.5s ease;
      .slider_list > :first-child &,
      .home-blog_card:hover & {
        max-height: 32rem;
      }
      .slider_list:hover > :first-child:not(:hover) & {
        max-height: 24rem;
      }
    }

    .home-blog_img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .home-blog_tag,
    .home-blog_title {
      text-box: normal;
    }

    .home-blog_tag {
      margin-block: 1rem 0.5rem;
      font-weight: var(--primary-medium);
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: var(--brand-500);
    }

    .home-blog_title {
      line-height: 1.3;
      color: var(--dark-900);
      text-wrap: wrap;
    }

    .reviews_rating {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: var(--space-2) var(--space-3);
      a {
        text-decoration: underline;
      }
    }

    .reviews_stars {
      width: 6.25rem;
    }

    .reviews_col {
      --_gap: var(--space-5);
      max-height: 57rem;
      overflow: clip;
      mask-image: linear-gradient(to bottom, transparent, black 8%, black 92%, transparent);
      @media (width < 48rem) {
        &:nth-child(n + 2) {
          display: none;
        }
      }
      @media (width >= 48rem) and (width < 64rem) {
        &:nth-child(3) {
          display: none;
        }
      }
    }

    .reviews_track {
      display: flex;
      flex-direction: column;
      gap: var(--_gap);
      animation: reviews_scroll 40s linear infinite;
      .reviews_col.reverse & {
        animation-direction: reverse;
      }
      @media (hover: hover) {
        .reviews_col:hover & {
          animation-play-state: paused;
        }
      }
    }

    .reviews_group {
      display: flex;
      flex-direction: column;
      gap: var(--_gap);
    }

    .reviews_card {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      padding: var(--space-5);
      background-color: var(--background-2);
      border-radius: var(--radius-main);
    }

    .reviews_text {
      white-space: pre-line;
    }

    .reviews_author {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
    }

    .reviews_person {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .reviews_avatar {
      flex: none;
      width: 2.75rem;
      aspect-ratio: 1 / 1;
      border-radius: var(--radius-round);
    }

    .reviews_source {
      flex: none;
      width: 1.5rem;
    }

    /* The list repeats once, so moving it by half of itself, plus half a gap, loops without a jump. */
    @keyframes reviews_scroll {
      to {
        translate: 0 calc(-50% - var(--_gap) / 2);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .reviews_col {
        max-height: none;
        mask-image: none;
      }
      .reviews_track {
        animation: none;
      }
      .reviews_group[aria-hidden] {
        display: none;
      }
    }
  }
</style>
