---
import Layout from "@/layouts/BaseLayout.astro";
import PropertyListing from "@/components/section/PropertyListing.astro";

// Filters live in the URL and run as Sanity (GROQ) queries on the server.
export const prerender = false;
---

<Layout
  theme="light"
  title="Properties for Sale in Murcia & Alicante"
  description="Browse new build and resale homes for sale in Murcia and Alicante, listed by a family-run estate agency with honest local advice."
  imageAlt="Whitewashed coastal town overlooking the Mediterranean"
>
  <PropertyListing heading="Let’s find your next home in Alicante &amp; Murcia" basePath="/listing" />
</Layout>
