---
import Layout from "@/layouts/BaseLayout.astro";
import PropertyListing from "@/components/section/PropertyListing.astro";

// Filters live in the URL and run as Sanity (GROQ) queries on the server.
export const prerender = false;
---

<Layout
  theme="light"
  title="Property for Sale in Murcia, Spain"
  description="Browse new build and resale homes for sale in Murcia, listed by a family-run estate agency with honest local advice."
  imageAlt="Whitewashed coastal town overlooking the Mediterranean"
>
  <PropertyListing heading="Let’s find your next home in Murcia" basePath="/murcia-properties" lock={{ province: "Murcia" }} />
</Layout>
