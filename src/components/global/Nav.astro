---
import Icon from "@/components/media/Icon.astro";
import Img from "@/components/media/Img.astro";
import Button from "@/components/Button.astro";
import NavLink from "@/components/global/NavLink.astro";
import logo from "@/assets/logo/solmar-card.png";
import chevron from "@/assets/icons/chevron-down.svg";
import whatsapp from "@/assets/icons/whatsapp.svg";
import { SITE_NAME, SITE_PHONE, SITE_PHONE_HREF, SITE_WHATSAPP } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
---

{render && (
  <header class:list={["nav_wrap", overlap && "overlap"]}>
    <div class="nav_inner">
      <a class="nav_logo" href="/" aria-label={`${SITE_NAME} home`}>
        <Img src={logo} alt="" width={184} loading="eager" transparent />
      </a>
      <button
        class="nav_toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav_toggle_icon" />
      </button>
      <nav class="nav_menu" id="nav-menu" aria-label="Main">
        <div class="nav_menu_inner">
          <ul class="nav_links">
            <li class="nav_item">
              <details class="nav_sub">
                <summary class="nav_link nav_sub_toggle">
                  <span class="nav_sub_label text-style-trim">Properties</span>
                  <Icon class="nav_sub_icon" src={chevron} variant="small" />
                </summary>
                <ul class="nav_sub_list">
                  <NavLink href="/listing">All Properties</NavLink>
                  <NavLink href="/murcia-properties">Murcia Properties</NavLink>
                  <NavLink href="/alicante-properties">Alicante Properties</NavLink>
                  <NavLink href="/new-build-properties">New Build</NavLink>
                </ul>
              </details>
            </li>
            <NavLink href="/buying-in-spain">Buying in Spain</NavLink>
            <NavLink href="/blog">Blog</NavLink>
            <NavLink href="/about-us">About Us</NavLink>
          </ul>
          <div class="nav_actions">
            <a class="nav_phone text-style-main" href={SITE_PHONE_HREF}>
              {SITE_PHONE}
            </a>
            <div class="nav_buttons">
              <a
                class="button_wrap secondary nav_whatsapp"
                href={SITE_WHATSAPP}
                target="_blank"
                rel="noopener"
                aria-label="Chat on WhatsApp"
              >
                <Icon src={whatsapp} variant="small" />
              </a>
              <Button element="link" href="/contact">Contact Us</Button>
            </div>
          </div>
        </div>
      </nav>
    </div>
  </header>
)}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");
  const sub = nav?.querySelector<HTMLDetailsElement>(".nav_sub");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        setOpen(false);
        if (sub) sub.open = false;
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (sub?.open) {
        sub.open = false;
        sub.querySelector("summary")?.focus();
      } else if (nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (sub?.open && !sub.contains(target)) sub.open = false;
      if (nav.classList.contains("open") && !nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 64rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });

    const root = document.documentElement;
    const threshold = 8;
    let lastY = window.scrollY;
    let ticking = false;

    const setHidden = (hidden: boolean) => {
      nav.classList.toggle("hidden", hidden);
      root.dataset.nav = hidden ? "hidden" : "visible";
    };

    const onScroll = () => {
      const y = Math.max(window.scrollY, 0);
      const pinned = nav.classList.contains("open") || Boolean(sub?.open);
      if (pinned || y <= nav.offsetHeight) {
        setHidden(false);
      } else if (y - lastY > threshold) {
        setHidden(true);
      } else if (lastY - y > threshold) {
        setHidden(false);
      } else {
        return;
      }
      lastY = y;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          onScroll();
          ticking = false;
        });
      },
      { passive: true },
    );
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--light-100);
      color: var(--dark-900);
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);

      &.hidden:not(:focus-within) {
        transform: translateY(-100%);
      }

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      min-height: var(--nav-height);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-6);
    }

    .nav_logo {
      display: block;
      width: 9.5rem;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.7;
        }
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--light-100);
      border-bottom: var(--border-width) solid var(--light-300);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      padding-inline: var(--site-margin);
      transition: opacity var(--hover-duration) var(--hover-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding-top: var(--space-2);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      & > li + li {
        border-top: var(--border-width) solid var(--light-300);
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: var(--dark-700);
      text-decoration: none;
      letter-spacing: var(--letter-spacing-normal);
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--brand-500);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--dark-900);
        }
      }
    }

    .nav_sub_toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-1);
      cursor: pointer;
      list-style: none;
      &::-webkit-details-marker {
        display: none;
      }
    }

    .nav_sub_icon {
      width: 1rem;
      transition: rotate var(--hover-duration) var(--hover-ease);
    }

    .nav_sub[open] .nav_sub_icon {
      rotate: 180deg;
    }

    .nav_sub_list {
      display: flex;
      flex-direction: column;
      padding-bottom: var(--space-2);
      padding-left: var(--space-4);
    }

    .nav_actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3) var(--space-4);
      padding-block: var(--space-4) var(--space-5);
    }

    .nav_phone {
      color: var(--dark-700);
      letter-spacing: var(--letter-spacing-normal);
      white-space: nowrap;
    }

    .nav_buttons {
      display: flex;
      align-items: stretch;
      gap: var(--space-2);
    }

    .nav_whatsapp {
      padding-inline: 1rem;
      color: var(--brand-500);
    }

    @media (width >= 64rem) {
      .nav_logo {
        width: 11.5rem;
      }
      .nav_toggle {
        display: none;
      }
      .nav_inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      }
      .nav_menu,
      .nav_menu_inner {
        display: contents;
      }
      .nav_menu {
        visibility: visible;
      }
      .nav_menu_inner {
        opacity: 1;
        padding: 0;
      }
      .nav_links {
        flex-direction: row;
        align-items: center;
        gap: var(--space-6);
        padding: 0;
        & > li + li {
          border-top: 0;
        }
      }
      .nav_link {
        padding-block: var(--space-2);
      }
      .nav_item {
        position: relative;
      }
      .nav_sub_list {
        position: absolute;
        top: calc(100% + var(--space-2));
        left: calc(var(--space-4) * -1);
        min-width: 14rem;
        padding: var(--space-2) var(--space-4);
        background-color: var(--light-100);
        border: var(--border-width) solid var(--light-300);
        border-radius: var(--radius-main);
        box-shadow: 0 1rem 2rem -0.5rem rgb(31 42 55 / 0.15);
      }
      .nav_actions {
        justify-content: flex-end;
        flex-wrap: nowrap;
        padding: 0;
        gap: var(--space-5);
      }
    }
  }
</style>
