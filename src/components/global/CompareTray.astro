---
import Icon from "@/components/media/Icon.astro";
import compare from "@/assets/icons/compare.svg";
---

<div class="compare-tray is-hidden" data-compare-tray>
  <button class="compare-tray_btn" type="button" aria-label="Open compare list" aria-expanded="false" aria-controls="compare-pop">
    <span class="compare-tray_count" data-compare-count>0</span>
    <span class="compare-tray_icon"><Icon src={compare} variant="full-width" /></span>
  </button>
</div>

<div class="compare-pop" id="compare-pop" role="dialog" aria-label="Compare properties" hidden>
  <div class="compare-pop_head">
    <p class="compare-pop_title">Compare Properties</p>
    <button class="compare-pop_close" type="button" aria-label="Close">&times;</button>
  </div>
  <ul class="compare-pop_list" data-compare-list></ul>
  <a class="compare-pop_go" href="/compare" data-compare-go aria-disabled="true">Compare</a>
  <p class="compare-pop_hint" data-compare-hint role="status"></p>
  <template data-compare-item>
    <li class="compare-pop_item">
      <img class="compare-pop_img" alt="" width="160" height="120" />
      <button class="compare-pop_remove" type="button" aria-label="Remove"><span class="compare-pop_bar" aria-hidden="true"></span></button>
      <p class="compare-pop_name"></p>
    </li>
  </template>
</div>

<p class="compare-toast" data-compare-toast role="status"></p>

<script>
  // Compare list: up to three properties, kept in localStorage so it follows you between pages.
  // Any element with [data-compare] (cards, detail page) toggles its property; handled by delegation,
  // so cards added by "Load more" or the instant filters work without extra code.
  const KEY = "ph_compare";
  const MAX = 3;
  type Item = { slug: string; name: string; img: string };

  const tray = document.querySelector<HTMLElement>("[data-compare-tray]")!;
  const trayBtn = tray.querySelector<HTMLButtonElement>(".compare-tray_btn")!;
  const count = tray.querySelector<HTMLElement>("[data-compare-count]")!;
  const pop = document.querySelector<HTMLElement>("#compare-pop")!;
  const list = pop.querySelector<HTMLElement>("[data-compare-list]")!;
  const go = pop.querySelector<HTMLAnchorElement>("[data-compare-go]")!;
  const hint = pop.querySelector<HTMLElement>("[data-compare-hint]")!;
  const template = pop.querySelector<HTMLTemplateElement>("[data-compare-item]")!;
  const toastEl = document.querySelector<HTMLElement>("[data-compare-toast]")!;
  let toastTimer: number | undefined;

  const read = (): Item[] => {
    try {
      const value = JSON.parse(localStorage.getItem(KEY) ?? "[]");
      return Array.isArray(value) ? value.filter((x) => x && typeof x.slug === "string").slice(0, MAX) : [];
    } catch {
      return [];
    }
  };
  const write = (items: Item[]) => {
    try {
      localStorage.setItem(KEY, JSON.stringify(items));
    } catch {}
  };

  const toast = (message: string) => {
    toastEl.textContent = message;
    toastEl.classList.add("is-on");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toastEl.classList.remove("is-on"), 2200);
  };

  const setOpen = (open: boolean) => {
    pop.hidden = !open || read().length === 0;
    trayBtn.setAttribute("aria-expanded", String(!pop.hidden));
  };

  const render = () => {
    const items = read();
    count.textContent = String(items.length);
    tray.classList.toggle("is-hidden", items.length === 0);
    list.replaceChildren(
      ...items.map((item) => {
        const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const img = row.querySelector<HTMLImageElement>(".compare-pop_img")!;
        if (item.img) img.src = item.img;
        else img.remove();
        row.querySelector<HTMLElement>(".compare-pop_name")!.textContent = item.name;
        row.querySelector<HTMLButtonElement>(".compare-pop_remove")!.dataset.remove = item.slug;
        return row;
      }),
    );
    const ready = items.length >= 2;
    go.setAttribute("aria-disabled", String(!ready));
    go.href = ready ? `/compare?p=${items.map((x) => encodeURIComponent(x.slug)).join(",")}` : "/compare";
    hint.textContent = items.length === 1 ? "Add one more property to compare." : items.length >= MAX ? `Maximum ${MAX} properties.` : "";
    if (!items.length) setOpen(false);

    const full = items.length >= MAX;
    document.querySelectorAll<HTMLButtonElement>("[data-compare]").forEach((button) => {
      const added = items.some((x) => x.slug === button.dataset.slug);
      button.setAttribute("aria-pressed", String(added));
      button.setAttribute("aria-label", added ? "Remove from compare" : "Add to compare");
      button.title = added ? "Remove from compare" : full ? "Compare list is full" : "Add to compare";
      button.disabled = full && !added;
    });
  };

  const toggle = (button: HTMLElement) => {
    const { slug = "", name = "", img = "" } = button.dataset;
    if (!slug) return;
    const items = read();
    const at = items.findIndex((x) => x.slug === slug);
    if (at > -1) items.splice(at, 1);
    else if (items.length >= MAX) return toast(`You can compare up to ${MAX} properties.`);
    else items.push({ slug, name, img });
    write(items);
    render();
    if (at === -1) setOpen(true);
  };

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const button = target.closest<HTMLElement>("[data-compare]");
    if (button) return toggle(button);
    if (target.closest(".compare-tray_btn")) return setOpen(Boolean(pop.hidden));
    if (target.closest(".compare-pop_close")) return setOpen(false);
    const remove = target.closest<HTMLElement>("[data-remove]");
    if (remove) {
      write(read().filter((x) => x.slug !== remove.dataset.remove));
      return render();
    }
    if (target.closest("[data-compare-go]") && go.getAttribute("aria-disabled") === "true") return event.preventDefault();
    if (!pop.hidden && !target.closest("#compare-pop")) setOpen(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !pop.hidden) {
      setOpen(false);
      trayBtn.focus();
    }
  });
  window.addEventListener("storage", (event) => event.key === KEY && render());

  // Cards arrive later (Load more, instant filters), so re-sync button states when the DOM changes.
  new MutationObserver(() => render()).observe(document.querySelector("main")!, { childList: true, subtree: true });
  render();
</script>

<style is:global>
  @layer components {
    .compare-tray {
      position: fixed;
      inset-inline-end: 0;
      top: 50%;
      z-index: 90;
      translate: 0 -50%;
      transition: opacity 0.2s ease, translate 0.2s ease;
      &.is-hidden {
        opacity: 0;
        visibility: hidden;
        translate: 100% -50%;
        pointer-events: none;
      }
    }

    .compare-tray_btn {
      position: relative;
      display: grid;
      place-items: center;
      width: 3.25rem;
      height: 3.25rem;
      border-radius: 0.375rem 0 0 0.375rem;
      background-color: #2b2b2b;
      color: var(--light-100);
      cursor: pointer;
    }

    .compare-tray_icon {
      width: 1.4rem;
    }

    .compare-tray_count {
      position: absolute;
      top: -0.5rem;
      inset-inline-start: -0.5rem;
      min-width: 1.25rem;
      height: 1.25rem;
      padding-inline: 0.25rem;
      border-radius: 0.625rem;
      background-color: var(--brand-500);
      color: var(--light-100);
      font-size: 0.75rem;
      line-height: 1.25rem;
      text-align: center;
    }

    .compare-pop {
      position: fixed;
      inset-inline-end: 4.5rem;
      top: 50%;
      z-index: 91;
      translate: 0 -50%;
      width: min(27rem, calc(100vw - 5.5rem));
      padding: 1.25rem;
      border-radius: 0.5rem;
      background-color: var(--light-100);
      color: #111827;
      box-shadow: 0 14px 44px rgb(0 0 0 / 18%);
      &[hidden] {
        display: none;
      }
      @media (width < 40rem) {
        inset-inline: 0.75rem;
        width: auto;
      }
    }

    .compare-pop_head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.875rem;
    }

    .compare-pop_title {
      font-size: 1.125rem;
      font-weight: var(--primary-medium);
    }

    .compare-pop_close {
      padding: 0 0.25rem;
      font-size: 1.5rem;
      line-height: 1;
      color: #666;
      cursor: pointer;
    }

    .compare-pop_list {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }

    .compare-pop_item {
      position: relative;
      flex: 1 1 0;
      min-width: 0;
    }

    .compare-pop_img {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      border-radius: 0.25rem;
      object-fit: cover;
      background-color: var(--background-2);
    }

    .compare-pop_name {
      display: -webkit-box;
      margin-top: 0.375rem;
      overflow: hidden;
      font-size: 0.75rem;
      line-height: 1.5;
      color: #333;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .compare-pop_remove {
      position: absolute;
      top: 0.375rem;
      inset-inline-end: 0.375rem;
      width: 1.625rem;
      height: 1.625rem;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background-color: rgb(25 25 25 / 85%);
      color: var(--light-100);
      cursor: pointer;
    }

    /* The minus is drawn, not typed, so it sits exactly in the middle of the circle. */
    .compare-pop_bar {
      width: 0.625rem;
      height: 2px;
      border-radius: 1px;
      background-color: currentcolor;
    }

    .compare-pop_go {
      display: block;
      padding: 0.875rem 1rem;
      border-radius: 0.375rem;
      background-color: var(--brand-500);
      color: var(--light-100);
      font-size: 1.0625rem;
      font-weight: var(--primary-medium);
      text-align: center;
      text-decoration: none;
      &[aria-disabled="true"] {
        opacity: 0.45;
        cursor: not-allowed;
      }
    }

    .compare-pop_hint {
      min-height: 1rem;
      margin-top: 0.5rem;
      font-size: 0.75rem;
      color: #888;
      text-align: center;
    }

    .compare-toast {
      position: fixed;
      inset-inline: 0;
      bottom: 1.75rem;
      z-index: 92;
      width: fit-content;
      margin-inline: auto;
      padding: 0.625rem 1.125rem;
      border-radius: 0.375rem;
      background-color: #2b2b2b;
      color: var(--light-100);
      font-size: 0.875rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      &.is-on {
        opacity: 1;
      }
    }
  }
</style>
