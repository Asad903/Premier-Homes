---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import Icon from "@/components/media/Icon.astro";
import plus from "@/assets/icons/plus.svg";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"details"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Item heading. */
  heading?: string;
  /** Heading level. */
  headingTag?: "h2" | "h3" | "h4" | "h5" | "h6";
  /** Open on load. */
  open?: boolean;
};

const {
  render = true,
  heading,
  headingTag = "h3",
  open = false,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{render && heading && content && (
  <details
    class:list={["accordion_item", className]}
    open={open}
    data-accordion-group
    {...rest}
  >
    <summary class="accordion_toggle">
      <Heading tag={headingTag} variant="h6" class="accordion_title">
        {heading}
      </Heading>
      <Icon class="accordion_icon" src={plus} variant="small" />
    </summary>

    <div class="accordion_body margin-trim">
      <Fragment set:html={content} />
    </div>
  </details>
)}

<style is:global>
  @layer components {
    .accordion_item {
      interpolate-size: allow-keywords;
      padding-inline: var(--space-4);
      border: var(--border-width) solid var(--border);
      transition: border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          border-color: currentcolor;
        }
      }
    }

    .accordion_item + .accordion_item {
      margin-top: var(--space-3);
    }

    .accordion_toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding-block: calc(var(--space-4) + 0.25rem);
      list-style: none;
      cursor: pointer;
      &::-webkit-details-marker {
        display: none;
      }
    }

    .accordion_title {
      margin-block: 0;
    }

    .accordion_icon {
      flex: none;
      width: 1.25rem;
      transition: rotate var(--open-duration) var(--open-ease);
    }

    .accordion_item:is([open], .stacki-opened) .accordion_icon,
    .stacki-designer .accordion_wrap.preview .accordion_icon {
      rotate: 45deg;
    }

    .accordion_item::details-content {
      block-size: 0;
      overflow: hidden;
      content-visibility: hidden;
    }

    @supports (interpolate-size: allow-keywords) {
      .accordion_item::details-content {
        transition:
          block-size var(--open-duration) var(--open-ease),
          content-visibility var(--open-duration) var(--open-ease)
            allow-discrete;
      }
    }

    .accordion_item:is([open], .stacki-opened)::details-content,
    .stacki-designer .accordion_wrap.preview .accordion_item::details-content {
      block-size: auto;
      content-visibility: visible;
    }

    .accordion_body {
      padding-bottom: var(--space-5);
    }
  }
</style>
