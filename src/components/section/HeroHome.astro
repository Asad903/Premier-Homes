---
import type { ComponentProps } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Img from "@/components/media/Img.astro";
import Overlay from "@/components/media/Overlay.astro";
import PropertySearch from "@/components/content/PropertySearch.astro";
import slide1 from "@/assets/images/hero/slide-1.avif";
import slide2 from "@/assets/images/hero/slide-2.avif";
import slide3 from "@/assets/images/hero/slide-3.avif";
import slide4 from "@/assets/images/hero/slide-4.avif";
import slide5 from "@/assets/images/hero/slide-5.avif";

type Props = Pick<ComponentProps<typeof Section>, "render">;

const { render = true } = Astro.props;

const slides = [
  { image: slide1, title: "Helping You Find the Right <br>Home in Murcia &amp; Alicante" },
  { image: slide2, title: "Get yourself <br>a place in the sun" },
  { image: slide3, title: "Culture on <br>Your Doorstep" },
  { image: slide4, title: "Live Like <br>a Local" },
  { image: slide5, title: "Coast, Culture <br>and Connection" },
];
---

<Section render={render} theme="dark" paddingTop="none" paddingBottom="none">
  <Fragment slot="background">
    <div class="hero-home_slides" aria-hidden="true">
      {slides.map((slide, index) => (
        <div class="hero-home_slide" style={`--_i: ${index};`}>
          <Img
            class="height-full"
            src={slide.image}
            width={1728}
            loading={index === 0 ? "eager" : "lazy"}
            fetchPriority={index === 0 ? "high" : "low"}
          />
        </div>
      ))}
    </div>
    <Overlay strength={30} />
  </Fragment>
  <div class="hero-home_layout">
    <ContentWrapper centered={true}>
      <Eyebrow variant="muted">Family-run estate agents in Murcia &amp; Alicante</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={30}>
        <span class="hero-home_titles">
          {slides.map((slide, index) => (
            <span
              class="hero-home_title"
              style={`--_i: ${index};`}
              aria-hidden={index === 0 ? undefined : "true"}
              set:html={slide.title}
            />
          ))}
        </span>
      </Heading>
    </ContentWrapper>
    <PropertySearch />
  </div>
</Section>

<style is:global>
  @layer components {
    .hero-home_layout {
      width: 100%;
      min-height: clamp(40rem, calc(100svh - var(--nav-height)), 64rem);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-8);
      padding-block: clamp(3rem, 7vw, 7.5rem) clamp(1.5rem, 4vw, 4rem);
    }

    .hero-home_slides {
      --_step: 3s;
      --_count: 5;
      overflow: clip;
      isolation: isolate;
    }

    .hero-home_slide {
      position: absolute;
      inset: 0;
      z-index: 0;
      visibility: hidden;
      transform: translateY(100%) skewY(8deg);
      transform-origin: left bottom;
      animation: hero-home_slide calc(var(--_step) * var(--_count)) infinite both;
      animation-delay: calc(var(--_i) * var(--_step) - 1.2s);
    }

    .hero-home_titles {
      --_step: 3s;
      --_count: 5;
      display: grid;
    }

    .hero-home_title {
      display: block;
      grid-area: 1 / 1;
      opacity: 0;
      transform: translateY(1.5rem);
      animation: hero-home_title calc(var(--_step) * var(--_count)) infinite both;
      animation-delay: calc(var(--_i) * var(--_step) - 1.1s);
    }

    /* Percentages assume 5 slides, a 3s step and a 1.2s transition (15s cycle). */
    @keyframes hero-home_slide {
      0% {
        z-index: 2;
        visibility: visible;
        transform: translateY(100%) skewY(8deg);
        animation-timing-function: cubic-bezier(0.77, 0, 0.18, 1);
      }
      8%,
      19.99% {
        z-index: 2;
        visibility: visible;
        transform: none;
      }
      20%,
      27.9% {
        z-index: 1;
        visibility: visible;
        transform: none;
      }
      28%,
      100% {
        z-index: 0;
        visibility: hidden;
        transform: translateY(100%) skewY(8deg);
      }
    }

    @keyframes hero-home_title {
      0%,
      2.67% {
        opacity: 0;
        transform: translateY(1.5rem);
      }
      7.33%,
      20% {
        opacity: 1;
        transform: none;
      }
      22.67% {
        opacity: 0;
        transform: translateY(-1.5rem);
      }
      22.7%,
      100% {
        opacity: 0;
        transform: translateY(1.5rem);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-home_slide,
      .hero-home_title {
        animation: none;
      }
      .hero-home_slide:first-child {
        visibility: visible;
        transform: none;
      }
      .hero-home_title:first-child {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
