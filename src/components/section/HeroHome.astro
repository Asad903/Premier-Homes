---
import type { HTMLAttributes } from "astro/types";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";

type Props = HTMLAttributes<"section"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

const { render = true, class: className, ...rest } = Astro.props;

const stats = [
  { value: "0", label: "Deposits lost in over 20 years" },
  { value: "100%", label: "Of purchases completed" },
  { value: "60–70%", label: "Of clients come by personal referral" },
];
---

{render && (
  <section class:list={["hero-home_wrap theme-brand", className]} {...rest}>
    <div class="hero-home_sky" aria-hidden="true">
      <div class="hero-home_glow"></div>
      <div class="hero-home_sun"></div>
      <svg class="hero-home_waves" viewBox="0 0 1440 360" preserveAspectRatio="none" focusable="false">
        <path class="hero-home_wave back" d="M0 150C180 100 330 90 520 130S880 210 1080 170 1330 100 1440 130V360H0Z" />
        <path class="hero-home_wave mid" d="M0 210C200 160 360 170 560 210S900 270 1100 235 1340 175 1440 200V360H0Z" />
        <path class="hero-home_wave front" d="M0 275C220 235 400 250 620 280S960 320 1160 290 1360 250 1440 265V360H0Z" />
      </svg>
    </div>
    <div class="hero-home_inner">
      <div class="hero-home_content">
        <Eyebrow>Murcia · Alicante · Costa Cálida</Eyebrow>
        <Heading tag="h1" variant="h1" maxWidth={16} class="margin-top-4 margin-bottom-0">
          Helping you find the right home in Murcia &amp; Alicante
        </Heading>
        <Paragraph variant="large" maxWidth={34} class="margin-top-5 margin-bottom-0">
          A family-run agency with more than twenty years of local knowledge,
          here from your first viewing to long after you collect the keys.
        </Paragraph>
        <ButtonWrapper class="margin-top-5">
          <Button element="link" href="/listing">Browse properties</Button>
          <Button element="link" href="/contact" emphasis="secondary">
            Book a viewing trip
          </Button>
        </ButtonWrapper>
      </div>
      <ul class="hero-home_stats">
        {stats.map((stat) => (
          <li class="hero-home_stat">
            <p class="hero-home_stat_value text-style-h3">{stat.value}</p>
            <p class="hero-home_stat_label text-style-small">{stat.label}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style is:global>
  @layer components {
    .hero-home_wrap {
      position: relative;
      display: flex;
      align-items: center;
      min-height: clamp(32rem, calc(100svh - var(--nav-height)), 46rem);
      overflow: clip;
      isolation: isolate;
      background-image: linear-gradient(
        160deg,
        color-mix(in srgb, var(--brand-500), black 35%) 0%,
        var(--brand-500) 55%,
        color-mix(in srgb, var(--brand-500), white 18%) 100%
      );

      .hero-home_sky {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
      }
      .hero-home_glow {
        position: absolute;
        right: -10%;
        bottom: 5%;
        width: min(70vw, 52rem);
        aspect-ratio: 1 / 1;
        border-radius: var(--radius-round);
        background-image: radial-gradient(
          circle,
          color-mix(in srgb, var(--gold-500) 45%, transparent) 0%,
          transparent 65%
        );
      }
      .hero-home_sun {
        position: absolute;
        right: clamp(2rem, 12vw, 14rem);
        bottom: clamp(5rem, 11%, 8rem);
        width: clamp(8rem, 20vw, 18rem);
        aspect-ratio: 1 / 1;
        border-radius: var(--radius-round);
        background-image: linear-gradient(
          180deg,
          color-mix(in srgb, var(--gold-500), white 30%) 0%,
          var(--gold-500) 55%,
          color-mix(in srgb, var(--gold-500), #e8590c 25%) 100%
        );
        box-shadow: 0 0 6rem 1rem color-mix(in srgb, var(--gold-500) 45%, transparent);
      }
      .hero-home_waves {
        position: absolute;
        left: 0;
        bottom: -1px;
        width: 100%;
        height: clamp(9rem, 28%, 17rem);
      }
      .hero-home_wave {
        &.back {
          fill: color-mix(in srgb, var(--brand-500), black 25%);
        }
        &.mid {
          fill: color-mix(in srgb, var(--brand-500), white 35%);
        }
        &.front {
          fill: var(--light-100);
        }
      }

      .hero-home_inner {
        width: var(--site-width);
        max-width: var(--max-width-main);
        margin-inline: auto;
        padding-block: var(--section-space-small) clamp(8rem, 16vw, 11rem);
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
      }
      .hero-home_content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }
      .hero-home_stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-5);
        max-width: 48rem;
        @media (width < 48rem) {
          grid-template-columns: minmax(0, 1fr);
          gap: var(--space-3);
        }
      }
      .hero-home_stat {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding-top: var(--space-3);
        border-top: var(--border-width) solid var(--border);
      }
      .hero-home_stat_label {
        color: var(--text-2);
      }
    }
  }
</style>
